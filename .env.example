# ── App ───────────────────────────────────────────────────────────────────── #
# Full public URL — used in email CTAs and Slack links
APP_URL=https://yourdomain.com
MARKETING_SITE_URL=https://platos.agency
CORS_ALLOWED_ORIGINS=
JSON_BODY_LIMIT=64kb
FORM_BODY_LIMIT=64kb

# ── Database ──────────────────────────────────────────────────────────────── #
DATABASE_URL=postgresql://platos:your_password@localhost:5432/platos

# ── Clerk auth ────────────────────────────────────────────────────────────── #
# Backend secret key (API server)
CLERK_SECRET_KEY=sk_live_...
# Frontend publishable key (baked into the Vite build)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── OpenAI (ICP brief parsing) ────────────────────────────────────────────── #
OPENAI_API_KEY=sk-...

# ── Email — Resend ────────────────────────────────────────────────────────── #
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Plato's <hello@yourdomain.com>

# ── Admin access ──────────────────────────────────────────────────────────── #
# Comma-separated Clerk email addresses that can access /admin
ADMIN_EMAILS=you@yourdomain.com

# ── Internal Slack notifications ──────────────────────────────────────────── #
# Incoming webhook URL — pings on workspace activation. Leave blank to disable.
INTERNAL_SLACK_WEBHOOK_URL=

# ── Scraper worker tuning (optional) ─────────────────────────────────────── #
JOB_RUNNER_INTERVAL_MS=60000
JOB_RUNNER_CONCURRENCY=3
ENABLE_PLAYWRIGHT=false

# ── Plato-owned enrichment waterfall (optional) ──────────────────────────── #
# Public DOM/context enrichment is enabled by default. It extracts real emails,
# phones, domains, and LinkedIn URLs from public pages before any paid fallback.
ENRICHMENT_ENABLED=true
ENRICHMENT_MAX_PAGES_PER_SIGNAL=4
PUBLIC_WEB_ENRICHMENT_LIMIT_PER_RUN=50
ENRICHMENT_FETCH_TIMEOUT_MS=9000
ENRICHMENT_USER_AGENT=platos-enrichment-bot/1.0

# Optional paid fallback. Leave blank to run Plato-owned enrichment only.
APOLLO_API_KEY=
ENRICHMENT_ALLOW_APOLLO_FALLBACK=true
APOLLO_ENRICHMENT_LIMIT_PER_RUN=25
APOLLO_REVEAL_PERSONAL_EMAILS=false
APOLLO_REVEAL_PHONE_NUMBER=false

# ── Public brief webhook protection ──────────────────────────────────────── #
# If set, /api/webhooks/brief requires X-Plato-Webhook-Secret or Bearer token.
PLATOS_BRIEF_WEBHOOK_SECRET=
BRIEF_WEBHOOK_IP_LIMIT_PER_HOUR=20
BRIEF_WEBHOOK_EMAIL_LIMIT_PER_DAY=3
