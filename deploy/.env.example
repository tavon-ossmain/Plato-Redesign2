# ── Database ──────────────────────────────────────────────────────────────── #
POSTGRES_USER=platos
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=platos

# ── App ───────────────────────────────────────────────────────────────────── #
# Full public URL of this deployment (used in emails/webhooks)
APP_URL=https://yourdomain.com

SESSION_SECRET=change_me_32_char_minimum_secret

# ── Clerk auth ────────────────────────────────────────────────────────────── #
# Get these from your Clerk dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ── OpenAI (ICP parsing) ──────────────────────────────────────────────────── #
OPENAI_API_KEY=sk-...

# ── Email (Resend) ────────────────────────────────────────────────────────── #
RESEND_API_KEY=re_...

# ── Admin ─────────────────────────────────────────────────────────────────── #
# Comma-separated list of Clerk email addresses that have /admin access
ADMIN_EMAILS=you@yourdomain.com

# Optional: Slack incoming webhook URL for activation pings
ADMIN_SLACK_WEBHOOK_URL=

# ── Job runner tuning (optional) ─────────────────────────────────────────── #
JOB_RUNNER_INTERVAL_MS=60000
JOB_RUNNER_CONCURRENCY=3

# Set to true and install playwright once you want the LinkedIn adapter
ENABLE_PLAYWRIGHT=false

# ── Plato-owned enrichment waterfall (optional) ──────────────────────────── #
ENRICHMENT_ENABLED=true
ENRICHMENT_MAX_PAGES_PER_SIGNAL=4
PUBLIC_WEB_ENRICHMENT_LIMIT_PER_RUN=50
ENRICHMENT_FETCH_TIMEOUT_MS=9000
ENRICHMENT_USER_AGENT=platos-enrichment-bot/1.0

# Optional paid fallback. Leave blank to avoid paid enrichment providers.
APOLLO_API_KEY=
ENRICHMENT_ALLOW_APOLLO_FALLBACK=true
APOLLO_ENRICHMENT_LIMIT_PER_RUN=25
APOLLO_REVEAL_PERSONAL_EMAILS=false
APOLLO_REVEAL_PHONE_NUMBER=false
