FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY package.json ./
COPY lib/db/package.json ./lib/db/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY artifacts/platos-core/package.json ./artifacts/platos-core/
RUN mkdir -p artifacts/api-server artifacts/mockup-sandbox scripts
RUN echo '{"name":"@workspace/api-server","version":"0.0.0"}' > artifacts/api-server/package.json
RUN echo '{"name":"@workspace/scripts","version":"0.0.0"}' > scripts/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS builder
COPY tsconfig.base.json tsconfig.json ./
COPY lib/ ./lib/
COPY artifacts/platos-core/ ./artifacts/platos-core/
RUN pnpm run typecheck:libs
# PORT and BASE_PATH are required by vite.config.ts at build time
ARG PORT=3000
ARG BASE_PATH=/
ENV PORT=$PORT
ENV BASE_PATH=$BASE_PATH
RUN pnpm --filter @workspace/platos-core run build

# Serve with nginx
FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/platos-core/dist/public /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
